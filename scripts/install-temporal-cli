#!/usr/bin/env bash
set -euo pipefail
if [ "$(uname -s)" != Linux ]; then
  echo 'Temporal CLI installer supports Linux only' >&2
  exit 1
fi

temporal_version=1.10.0
artifact_dir=${1:-.proof/bin}
case "$(uname -m)" in
  x86_64) temporal_arch=amd64 ;;
  aarch64|arm64) temporal_arch=arm64 ;;
  *) echo 'Unsupported Temporal CLI architecture' >&2; exit 1 ;;
esac
mkdir -p "$artifact_dir"
archive="temporal_cli_${temporal_version}_linux_${temporal_arch}.tar.gz"
release="https://github.com/temporalio/cli/releases/download/v${temporal_version}"
curl -fsSL "$release/$archive" -o "$artifact_dir/$archive"
curl -fsSL "$release/checksums.txt" -o "$artifact_dir/checksums.txt"
(cd "$artifact_dir" && grep " $archive$" checksums.txt | sha256sum -c -)
tar -xzf "$artifact_dir/$archive" -C "$artifact_dir" temporal
printf '%s\n' "$temporal_version" > "$artifact_dir/temporal-cli-version"
