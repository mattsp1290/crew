{
  "name": "@birbcrew/client", "version": "0.1.0", "type": "module",
  "description": "Portable Crew HTTP commands and explicit request reconciliation",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "files": ["dist", "README.md", "LICENSE", "openapi.json"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./contract": { "types": "./dist/contract.d.ts", "default": "./dist/contract.js" },
    "./agui": { "types": "./dist/agui.d.ts", "default": "./dist/agui.js" },
    "./openapi.json": "./openapi.json"
  },
  "scripts": { "build": "rm -rf dist && tsc -p tsconfig.json", "prepack": "npm run build" },
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": { "@ag-ui/client": "1.0.4", "@ag-ui/core": "1.0.4" },
  "peerDependenciesMeta": { "@ag-ui/client": { "optional": true }, "@ag-ui/core": { "optional": true } }
}
