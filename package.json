{
  "name": "crew",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "scripts": {
    "build": "npm run build:client && scripts/build-native && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/fixtures/engines/artifacts.test.ts tests/fixtures/engines/consumer.test.mjs tests/fixtures/engines/codex/qualification.test.ts tests/fixtures/engines/pi/confinement.test.ts tests/service/temporal-config.test.ts tests/service/gateway-auth.test.ts",
    "gateway": "node src/service/gateway.ts",
    "members": "node src/service/cli.ts",
    "test:integration": "scripts/verify-members",
    "test:live": "node tests/proof/live-members.ts",
    "test:proxy": "node --test tests/proxy-relay.test.ts tests/service/proxy-credential.test.ts tests/service/proxy-members.test.ts tests/service/proxy-scope.test.ts",
    "test:trusted": "node --test tests/service/trusted-*.test.ts",
    "test:telemetry": "node --test tests/service/telemetry-otlp.test.ts",
    "test:proxy:restart": "node tests/proof/proxy-restart.mts",
    "recovery": "node src/service/recovery-cli.ts",
    "test:recovery": "node --test tests/service/recovery.test.ts",
    "test:recovery:native": "node tests/proof/recovery-native.mts",
    "test:rollover": "node tests/proof/rollover.mts",
    "test:api": "node --test tests/service/integration-api.test.ts",
    "test:audit": "node --test tests/service/audit.test.ts",
    "test:routines": "node --test tests/service/routine-schedule.test.ts tests/service/routines.test.ts",
    "test:routines:service": "node tests/proof/routines.mts",
    "test:memories": "node --test tests/service/memories.test.ts",
    "test:memories:service": "node tests/proof/memories.mts",
    "test:instructions": "node --test tests/service/member-instructions.test.ts",
    "test:instructions:service": "node tests/proof/member-instructions.mts",
    "test:packs": "node --test tests/service/instruction-packs.test.ts",
    "test:handoffs:service": "node tests/proof/handoffs.mts",
    "test:grants": "node --test tests/service/standing-grants.test.ts",
    "test:expiry": "node --test tests/service/approval-expiry.test.ts",
    "test:expiry:workflow": "node --test tests/service/approval-expiry-workflow.test.ts",
    "test:handoffs": "node --test tests/service/handoffs.test.ts",
    "test:usage": "node --test tests/service/usage.test.ts tests/service/usage-cost.test.ts",
    "test:usage:capture": "node --test tests/service/usage-capture.test.ts",
    "test:child-targets": "node --test tests/service/child-targets.test.ts tests/service/child-target-workflow.test.ts",
    "test:webhooks": "node --test tests/service/webhook-target.test.ts tests/service/webhooks.test.ts",
    "test:api:service": "node tests/proof/integration-api.mts",
    "test:recovery:coordinated": "node tests/proof/coordinated-recovery.mts",
    "test:temporal:tls": "node tests/proof/temporal-tls.mts",
    "build:client": "npm run build --prefix packages/client",
    "openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "test:client": "node --test tests/client/*.test.mts",
    "verify:client": "node scripts/verify-client-package.mjs"
  },
  "dependencies": {
    "@ag-ui/claude-agent-sdk": "file:vendor/ag-ui/claude-agent-sdk-0.0.8.tgz",
    "@ag-ui/client": "1.0.4",
    "@ag-ui/core": "1.0.4",
    "@ag-ui/encoder": "1.0.4",
    "@ag-ui/pi": "file:vendor/ag-ui/ag-ui-pi-0.0.1.tgz",
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@anthropic-ai/sdk": "0.113.0",
    "@birbcrew/client": "file:packages/client",
    "@birbcrew/pi-subagents": "file:packages/pi-subagents/birbcrew-pi-subagents-0.1.0.tgz",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/codex": "0.167.1",
    "@openai/codex-sdk": "0.167.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "pg": "8.23.1",
    "rxjs": "7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "description": "Durable Claude, Codex and Pi coding coworkers",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattsp1290/crew.git"
  },
  "homepage": "https://github.com/mattsp1290/crew#readme",
  "bugs": {
    "url": "https://github.com/mattsp1290/crew/issues"
  }
}
