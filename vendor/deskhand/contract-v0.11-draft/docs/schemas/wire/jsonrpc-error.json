{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskhand.invalid/schemas/wire/jsonrpc-error.json",
  "title": "JSON-RPC error response",
  "description": "A JSON-RPC error that deskhand sends (docs/contract.md section 9.4). The codes are exactly those of the 9.4 table; deskhand never sends -32021, -32002 or -32042.",
  "type": "object",
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": {
      "description": "The request's id, or null when it could not be read (always for -32700).",
      "type": ["string", "integer", "null"]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "enum": [-32700, -32600, -32601, -32602, -32603, -32020, -32022] },
        "message": { "type": "string", "minLength": 1 },
        "data": {
          "description": "For diagnosis. Not stable.",
          "type": "object",
          "properties": {
            "detail": { "type": "string" },
            "header": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "required": ["jsonrpc", "id", "error"],
  "additionalProperties": false,
  "if": {
    "properties": { "error": { "properties": { "code": { "const": -32700 } }, "required": ["code"] } },
    "required": ["error"]
  },
  "then": { "properties": { "id": { "type": "null" } } }
}
