{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskhand.invalid/schemas/wire/server-discover-result.json",
  "title": "server/discover result",
  "description": "The result member of deskhand's server/discover response (docs/contract.md section 3.1). deskhand sends no instructions.",
  "type": "object",
  "properties": {
    "resultType": { "const": "complete" },
    "supportedVersions": {
      "description": "The MCP revisions deskhand supports: only the one in the contract header.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "object",
          "properties": { "listChanged": { "const": false } },
          "required": ["listChanged"],
          "additionalProperties": false
        }
      },
      "required": ["tools"],
      "additionalProperties": false
    },
    "_meta": {
      "type": "object",
      "properties": {
        "io.modelcontextprotocol/serverInfo": {
          "type": "object",
          "properties": {
            "name": { "const": "deskhand" },
            "version": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        }
      },
      "required": ["io.modelcontextprotocol/serverInfo"]
    },
    "ttlMs": { "description": "DISCOVERY_TTL_MS.", "const": 300000 },
    "cacheScope": { "const": "private" }
  },
  "required": ["resultType", "supportedVersions", "capabilities", "_meta", "ttlMs", "cacheScope"],
  "additionalProperties": false
}
